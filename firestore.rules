rules_version = '2';

// CFA Level I Burn-Down: one progress document per signed-in account, at progress/{uid}.
// An account can read and write only its own copy. Everything else is closed.
service cloud.firestore {
  match /databases/{database}/documents {
    match /progress/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
